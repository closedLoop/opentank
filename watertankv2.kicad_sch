	)
	(text "Most ESP32 development boards are simply unsuitable for\noutdoor sensor monitoring, with idle current consumption\nin the mA range. Efficient solar battery charging is seldom\nintegrated on-board, and other forms to optimise runtime\nare not considered enough. OpenTank aims to solve this.\nIt includes a 5V ADC with added powered-off protection."
		(exclude_from_sim no)
		(at 215.9 173.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6405ecbd-17c4-4a19-a891-1fc2656db694")
	)
